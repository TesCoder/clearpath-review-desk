{
  "name": "clearpath-review-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.local scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "vitest run",
    "eval": "APP_LLM=api LIVE_AI=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/lib/ai/live.eval.test.ts",
    "eval:cli": "APP_LLM=claude-cli EVAL_SAMPLE=3 LIVE_AI=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/lib/ai/live.eval.test.ts --silent=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
